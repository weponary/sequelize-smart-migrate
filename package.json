{
  "name": "sequelize-smart-migrate",
  "version": "0.0.1",
  "description": "Template-driven Sequelize migration generator CLI",
  "keywords": [
    "sequelize",
    "sequelize-cli",
    "migration",
    "generator",
    "skeleton",
    "orm",
    "cli"
  ],
  "homepage": "https://github.com/weponary/sequelize-smart-migrate#readme",
  "bugs": {
    "url": "https://github.com/weponary/sequelize-smart-migrate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weponary/sequelize-smart-migrate.git"
  },
  "license": "MIT",
  "author": {
    "name": "weponary",
    "url": "https://github.com/weponary"
  },
  "bin": {
    "smart-migrate": "dist/cli.js"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup && chmod +x dist/cli.js",
    "prepare": "npm run build && husky",
    "dev": "ts-node src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
